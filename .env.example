# JA Assure AI Marketing Intelligence & Risk Agent Configuration

# ==============================================================================
# LLM Provider Configuration
# ==============================================================================
# Active Provider Preference: 'groq' (primary) or 'gemini' (fallback)
LLM_PROVIDER=groq

# 1. Groq API Key (Primary LLM Provider)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Google Gemini API Key (Secondary Fallback LLM Provider)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# System & Database Configuration
# ==============================================================================
# System Execution Mode: set to 'true' to isolate judging demo fixtures into data/demo/ja_assure_demo.db
DEMO_MODE=false

# SQLite Database Path (Defaults to data/ja_assure.db when DEMO_MODE=false)
JA_ASSURE_DB_PATH=data/ja_assure.db

# Optional: Tavily Search API key for live insurance research and lead scraping
TAVILY_API_KEY=

# Port configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
STREAMLIT_PORT=8501

